FROM python:3.10-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY libs/ libs/
COPY services/agent_service/ services/agent_service/
COPY services/payments_api/stripe_client.py services/payments_api/stripe_client.py

EXPOSE 8080

CMD ["uv", "run", "adk", "api_server", "services.agent_service", "--host", "0.0.0.0", "--port", "8080"]
